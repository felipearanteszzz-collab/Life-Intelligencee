rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── REGRA PRINCIPAL ──
    // Cada usuário só acessa seu próprio documento em /users/{uid}
    // O projeto salva TUDO num único documento por usuário:
    // doc(db, 'users', user.uid) → { state: JSON, updatedAt: timestamp }
    
    match /users/{userId} {
      // Leitura: só o próprio usuário autenticado
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Escrita: só o próprio usuário autenticado
      // Garante que o campo 'state' é string e 'updatedAt' é número
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasAll(['state', 'updatedAt'])
                   && request.resource.data.state is string
                   && request.resource.data.updatedAt is number;
    }

    // ── NEGAR TUDO O MAIS ──
    // Bloqueia qualquer acesso a outras coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
